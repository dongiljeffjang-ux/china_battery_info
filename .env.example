# Vercel Project Settings → Environment Variables에 같은 이름으로 입력합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 서비스 입장 게이트. 임의의 긴 값이며 브라우저 코드에 넣지 않는다.
APP_ACCESS_KEY=
# LLM 번역·Daily 보고서 생성용. 브라우저에 노출하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=
# DeepSeek 중국 현지 독립 검색·기사 교차검증용.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
# 비어 있으면 text-embedding-3-small을 사용한다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REPORT_TEXT_ONLY_EMBEDDING=0
# POST /api/process-article 호출을 보호하는 임의의 긴 비밀값
CRON_SECRET=
