# Vercel Project Settings → Environment Variables에 같은 이름으로 입력합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 서비스 입장 게이트. 임의의 긴 값이며 브라우저 코드에 넣지 않는다.
APP_ACCESS_KEY=
# 일반 LLM 작업(뉴스 수집·본문 대조 등)용. 브라우저에 노출하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Daily·기업 시계열·비교 리포트 생성 전용 OpenAI 프로젝트/키와 모델. 일반 작업 키와 반드시 분리한다.
OPENAI_REPORT_API_KEY=
OPENAI_REPORT_MODEL=gpt-5.6-terra
# DeepSeek 중국 현지 독립 검색·기사 교차검증용.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
# 중국 현지 검색 레인의 엔진. 기본 openai. DeepSeek Responses API가 web_search 도구를 다시 지원하면 deepseek로 바꾼다.
CHINA_LOCAL_SEARCH_ENGINE=openai
# DeepSeek 웹 검색 전용 모델(엔진이 deepseek일 때만). 검색은 Anthropic 호환 경로(/anthropic/v1/messages)로
# 보내며 비우면 그 경로의 정식 ID deepseek-flash. 일반 구조화 작업(DEEPSEEK_MODEL)은 Responses API 그대로.
DEEPSEEK_SEARCH_MODEL=
# 비어 있으면 text-embedding-3-small을 사용한다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REPORT_TEXT_ONLY_EMBEDDING=0
# POST /api/process-article 호출을 보호하는 임의의 긴 비밀값
CRON_SECRET=
